{
	"APP": {
		"class": "InstanceMgr",
		"appName": "RTCMcast",
		"bLog": true,
		"bStdErr": true
	},
	"console": {
		"class": "_Console",
		"bON": true,
		"thread": {
			"FPS": 10
		},
		"vBASE": [
			"tcpNtrip",
			"RTCMcast",
			"udpRTCMsvr",
			"udpRTCMcli"
		]
	},


	"tcpNtrip": {
		"BytePacketStreamOut": "tcpNtrip_rx",
		"class": "_TCPclient",
		"bON": false,
		"thread": {
			"FPS": 30
		},
		"threadR": {
			"FPS": 30
		},
		"addr": "127.0.0.1",
		"port": 24608
	},

	"serialRTCM": {
		"BytePacketStreamOut": "serialRTCM_rx",
		"class": "_SerialPort",
		"bON": true,
		"thread": {
			"FPS": 50
		},
		"threadR": {
			"FPS": 50
		},
		"port": "/dev/ttyUSB0",
		"baud": 115200
	},

	"udpRTCMsvr": {
		"BytePacketStreamIn": "udpRTCMsvr_tx",
		"class": "_UDP",
		"bON": true,
		"thread": {
			"FPS": 10
		},
		"threadR": {
			"FPS": 10
		},
		"addrRemote": "127.0.0.1",
		"portRemote": 24609,
		"/portLocal": 24609,
		"bW2R": false,
		"bWbroadcast": false
	},

	"RTCMcast": {
		"class": "_RTCMcast",
		"bON": true,
		"thread": {
			"FPS": 1
		},
		"threadR": {
			"FPS": 30
		},
		"/BytePacketStreamIn": "tcpNtrip_rx",
		"BytePacketStreamIn": "serialRTCM_rx",
		"BytePacketStreamOut": "udpRTCMsvr_tx"
	},
	"tcpNtrip_rx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	},
	"serialRTCM_rx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	},
	"udpRTCMsvr_tx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	}
}