{
	"APP": {
		"class": "InstanceMgr",
		"appName": "OpenKAI",
		"bLog": true,
		"bStdErr": true
	},
	"console": {
		"class": "_Console",
		"bON": true,
		"thread": {
			"FPS": 10
		},
		"vBASE": [
			"/serialAP",
			"/mavAP",
			"apBase",
			"tcpNtrip",
			"RTCMcast",
			"/udpRTCMsvr",
			"/udpRTCMcli",
			"apRTCM"
		]
	},


	"serialAP": {
		"BytePacketStreamIn": "serialAP_tx",
		"BytePacketStreamOut": "serialAP_rx",
		"class": "_SerialPort",
		"bON": false,
		"thread": {
			"FPS": 30
		},
		"threadR": {
			"FPS": 30
		},
		"port": "/dev/ttyACM0",
		"baud": 115200
	},
	"udpAP": {
		"BytePacketStreamIn": "udpAP_tx",
		"BytePacketStreamOut": "udpAP_rx",
		"class": "_UDP",
		"bON": true,
		"thread": {
			"FPS": 30
		},
		"threadR": {
			"FPS": 30
		},
		"addrRemote": "192.168.16.203",
		"portRemote": 24603,
		"/portLocal": 24600,
		"bW2R": false,
		"bWbroadcast": false
	},
	"mavAP": {
		"class": "_Mavlink",
		"MavlinkStreamIn": "mavAP_tx",
		"MavlinkStreamOut": "mavAP_rx",
		"bON": true,
		"thread": {
			"FPS": 30
		},
		"bLog": false,
		"BytePacketStreamIn": "udpAP_rx",
		"BytePacketStreamOut": "udpAP_tx",
		"/BytePacketStreamIn": "serialAP_rx",
		"/BytePacketStreamOut": "serialAP_tx",
		"mySystemID": 200,
		"iMavComm": 0
	},

	"apBase": {
		"class": "_APmav_base",
		"bON": false,
		"thread": {
			"FPS": 10
		},
		"_StateControl": "state",
		"MavlinkStreamIn": "mavAP_rx",
		"MavlinkStreamOut": "mavAP_tx",
		"apType": 0,
		"ieSendHB": 1,
		"ieSendMsgInt": 1,
		"mavMsgInt": {
			"heartbeat": {
				"id": 0,
				"tInt": 0.4
			},
			"attitude": {
				"id": 30,
				"tInt": 0.3
			},
			"rcChannels": {
				"id": 65,
				"tInt": 1.0
			},
			"localPosition": {
				"id": 32,
				"tInt": 0.3
			},
			"globalPosition": {
				"id": 33,
				"tInt": 0.3
			},
			"homePosition": {
				"id": 242,
				"tInt": 10
			},
			"batteryStatus": {
				"id": 147,
				"tInt": 10
			},
			"missionCurrent": {
				"id": 42,
				"tInt": 1
			}
		}
	},


	"tcpNtrip": {
		"BytePacketStreamOut": "tcpNtrip_rx",
		"class": "_TCPclient",
		"bON": false,
		"thread": {
			"FPS": 30
		},
		"threadR": {
			"FPS": 30
		},
		"addr": "127.0.0.1",
		"port": 24608
	},
	"serialRTCM": {
		"BytePacketStreamOut": "serialRTCM_rx",
		"class": "_SerialPort",
		"bON": true,
		"thread": {
			"FPS": 10
		},
		"threadR": {
			"FPS": 10
		},
		"port": "/dev/ttyUSB0",
		"baud": 115200
	},

	"RTCMcast": {
		"class": "_RTCMcast",
		"bON": false,
		"thread": {
			"FPS": 1
		},
		"threadR": {
			"FPS": 30
		},
		"/BytePacketStreamIn": "tcpNtrip_rx",
		"BytePacketStreamIn": "serialRTCM_rx",
		"BytePacketStreamOut": "udpRTCMsvr_tx",
		"/RTCMmsg": [
			{
				"ID": 1006,
				"bSendOnceOnly": 0,
				"ieSendSec": 1,
				"tOutSec": 1
			}
		]
	},
	"udpRTCMsvr": {
		"BytePacketStreamIn": "udpRTCMsvr_tx",
		"class": "_UDP",
		"bON": false,
		"thread": {
			"FPS": 30
		},
		"threadR": {
			"FPS": 30
		},
		"addrRemote": "127.0.0.1",
		"portRemote": 24609,
		"/portLocal": 24609,
		"bW2R": false,
		"bWbroadcast": false
	},


	"udpRTCMcli": {
		"BytePacketStreamOut": "udpRTCMcli_rx",
		"class": "_UDP",
		"bON": false,
		"thread": {
			"FPS": 30
		},
		"threadR": {
			"FPS": 30
		},
		"/addrRemote": "127.0.0.1",
		"/portRemote": 24609,
		"portLocal": 24609,
		"bW2R": false,
		"bWbroadcast": false
	},

	"apRTCM": {
		"class": "_APmav_RTCM",
		"bON": true,
		"thread": {
			"FPS": 1
		},
		"threadR": {
			"FPS": 30
		},
		"BytePacketStreamIn": "serialRTCM_rx",
		"/BytePacketStreamIn": "udpRTCMcli_rx",
		"//BytePacketStreamIn": "tcpNtrip_rx",
		"MavlinkStreamIn": "mavAP_rx",
		"MavlinkStreamOut": "mavAP_tx"
	},
	"mavAP_tx": {
		"type": "dataObject",
		"class": "MavlinkStream",
		"nMsgQueue": 1024
	},
	"mavAP_rx": {
		"type": "dataObject",
		"class": "MavlinkStream",
		"nMsgQueue": 1024
	},
	"serialAP_tx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	},
	"serialAP_rx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	},
	"udpAP_tx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	},
	"udpAP_rx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	},
	"tcpNtrip_rx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	},
	"serialRTCM_rx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	},
	"udpRTCMsvr_tx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	},
	"udpRTCMcli_rx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	}
}