{
	"APP": {
		"class": "OpenKAI",
		"appName": "apDrive",
		"bLog": true,
		"bStdErr": true
	},


	"console": {
		"class": "_Console",
		"bON": true,
		"thread": {
			"FPS": 10
		},
		"vBASE": [
			"/serialAP",
			"/apMavlink",
			"apBase"
		]
	},

	"wsServer": {
		"class": "_WebSocketServer",
		"bON": true,
		"thread": {
			"FPS": 30
		},
		"threadR": {
			"FPS": 1
		},
		"host": "0.0.0.0",
		"port": 7890,
		"wsMode": 2,
		"nClientMax": 1,
		"tOutMs": 10000
	},
	"wsConsole": {
		"class": "_WSconsole",
		"bON": true,
		"thread": {
			"FPS": 10
		},
		"threadR": {
			"FPS": 30
		},
		"_IObase": "wsServer",
		"msgFinishSend": "",
		"msgFinishRecv": "EOJ",
		"vBASE": [
			"apBase"
		]
	},


	"serialAP": {
		"class": "_SerialPort",
		"bON": true,
		"thread": {
			"FPS": 10
		},
		"nPacket": 1024,
		"nPbuffer": 512,
		"port": "/dev/ttyACM0",
		"/port": "/dev/ttyAMA0",
		"//port": "/dev/ttyS0",
		"baud": 115200
	},
	"udpAP": {
		"class": "_UDP",
		"bON": false,
		"thread": {
			"FPS": 30
		},
		"nPacket": 256,
		"nPbuffer": 2000,
		"addrRemote": "192.168.16.203",
		"portRemote": 24602,
		"/portLocal": 24600,
		"bW2R": false,
		"bWbroadcast": false
	},

	"apMavlink": {
		"class": "_Mavlink",
		"bON": true,
		"thread": {
			"FPS": 10
		},
		"bLog": false,
		"_IObase": "serialAP",
		"/_IObase": "udpAP",
		"/devSystemID": 0,
		"mySystemID": 255,
		"iMavComm": 0
	},

	"apBase": {
		"class": "_APmav_copter",
		"bON": true,
		"thread": {
			"FPS": 10
		},
		"_StateControl": "state",
		"_Mavlink": "apMavlink",
		"apType": 1,
		"ieSendHB": 1,
		"ieSendMsgInt": 1,
		"mavMsgInt": {
			"heartbeat": {
				"id": 0,
				"tInt": 0.3
			},
			"attitude": {
				"id": 30,
				"tInt": 0.1
			},
			"gpsRawINT": {
				"id": 24,
				"tInt": 1
			},
			"localPosition": {
				"id": 32,
				"tInt": 0.6
			},
			"globalPosition": {
				"id": 33,
				"tInt": 0.2
			},
			"homePosition": {
				"id": 242,
				"tInt": 10
			},
			"batteryStatus": {
				"id": 147,
				"tInt": 10
			},
			"missionCurrent": {
				"id": 42,
				"tInt": 1
			}
		}
	}

}