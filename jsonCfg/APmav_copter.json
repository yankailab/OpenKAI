{
	"APP": {
		"class": "InstanceMgr",
		"appName": "apDrive",
		"bLog": true,
		"bStdErr": true
	},


	"console": {
		"class": "_Console",
		"bON": true,
		"thread": {
			"FPS": 10
		},
		"vBASE": [
			"/serialAP",
			"/apMavlink",
			"apBase"
		]
	},

	"wsServer": {
		"BytePacketStreamIn": "wsServer_tx",
		"BytePacketStreamOut": "wsServer_rx",
		"class": "_WebSocketServer",
		"bON": true,
		"thread": {
			"FPS": 30
		},
		"threadR": {
			"FPS": 1
		},
		"host": "0.0.0.0",
		"port": 7890,
		"wsMode": 2,
		"nClientMax": 1,
		"tOutMs": 10000
	},
	"wsConsole": {
		"class": "_WSconsole",
		"bON": true,
		"thread": {
			"FPS": 10
		},
		"threadR": {
			"FPS": 30
		},
		"BytePacketStreamIn": "wsServer_rx",
		"BytePacketStreamOut": "wsServer_tx",
		"msgFinishSend": "",
		"msgFinishRecv": "EOJ",
		"vBASE": [
			"apBase"
		]
	},


	"serialAP": {
		"BytePacketStreamIn": "serialAP_tx",
		"BytePacketStreamOut": "serialAP_rx",
		"class": "_SerialPort",
		"bON": false,
		"thread": {
			"FPS": 10
		},
		"threadR": {
			"FPS": 10
		},
		"port": "/dev/ttyACM0",
		"/port": "/dev/ttyAMA0",
		"//port": "/dev/ttyS0",
		"baud": 115200
	},
	"udpAP": {
		"BytePacketStreamIn": "udpAP_tx",
		"BytePacketStreamOut": "udpAP_rx",
		"class": "_UDP",
		"bON": true,
		"thread": {
			"FPS": 30
		},
		"threadR": {
			"FPS": 30
		},
		"addrRemote": "192.168.8.250",
		"portRemote": 24602,
		"/portLocal": 24600,
		"bW2R": false,
		"bWbroadcast": false
	},

	"apMavlink": {
		"class": "_Mavlink",
		"MavlinkStreamIn": "apMavlink_tx",
		"MavlinkStreamOut": "apMavlink_rx",
		"bON": true,
		"thread": {
			"FPS": 10
		},
		"bLog": false,
		"/BytePacketStreamIn": "serialAP_rx",
		"/BytePacketStreamOut": "serialAP_tx",
		"BytePacketStreamIn": "udpAP_rx",
		"BytePacketStreamOut": "udpAP_tx",
		"/devSystemID": 0,
		"mySystemID": 255,
		"iMavComm": 0
	},

	"apBase": {
		"class": "_APmav_copter",
		"bON": true,
		"thread": {
			"FPS": 10
		},
		"_StateControl": "state",
		"MavlinkStreamIn": "apMavlink_rx",
		"MavlinkStreamOut": "apMavlink_tx",
		"apType": 1,
		"ieSendHB": 1,
		"ieSendMsgInt": 1,
		"mavMsgInt": {
			"heartbeat": {
				"id": 0,
				"tInt": 0.3
			},
			"attitude": {
				"id": 30,
				"tInt": 0.1
			},
			"gpsRawINT": {
				"id": 24,
				"tInt": 1
			},
			"localPosition": {
				"id": 32,
				"tInt": 0.6
			},
			"globalPosition": {
				"id": 33,
				"tInt": 0.2
			},
			"homePosition": {
				"id": 242,
				"tInt": 10
			},
			"batteryStatus": {
				"id": 147,
				"tInt": 10
			},
			"missionCurrent": {
				"id": 42,
				"tInt": 1
			}
		}
	},
	"apMavlink_tx": {
		"type": "dataObject",
		"class": "MavlinkStream",
		"nMsgQueue": 1024
	},
	"apMavlink_rx": {
		"type": "dataObject",
		"class": "MavlinkStream",
		"nMsgQueue": 1024
	},
	"wsServer_tx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	},
	"wsServer_rx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	},
	"serialAP_tx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 1024,
		"nPbuf": 512
	},
	"serialAP_rx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 1024,
		"nPbuf": 512
	},
	"udpAP_tx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	},
	"udpAP_rx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	}
}