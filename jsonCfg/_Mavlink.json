{
	"APP": {
		"class": "InstanceMgr",
		"appName": "OpenKAI",
		"bLog": true,
		"bStdErr": true
	},
	"console": {
		"class": "_Console",
		"bON": true,
		"thread": {
			"FPS": 30
		},
		"vBASE": [
			"serial",
			"mavAP",
			"apBase",
			"udp",
			"mavUDP"
		]
	},
	"serial": {
		"BytePacketStreamIn": "serial_tx",
		"BytePacketStreamOut": "serial_rx",
		"class": "_SerialPort",
		"bON": true,
		"thread": {
			"FPS": 10
		},
		"threadR": {
			"FPS": 10
		},
		"/port": "/dev/ttyUSB0",
		"port": "/dev/ttyACM0",
		"/port": "/dev/ttyAMA0",
		"/port": "/dev/ttyTHS1",
		"baud": 115200,
		"/baud": 921600
	},
	"mavAP": {
		"class": "_Mavlink",
		"MavlinkStream": "mavAP_stream",
		"bON": true,
		"bLog": false,
		"thread": {
			"FPS": 10
		},
		"BytePacketStreamIn": "serial_rx",
		"BytePacketStreamOut": "serial_tx",
		"devSystemID": 1,
		"mySystemID": 200,
		"iMavComm": 0
	},
	"apBase": {
		"class": "_APmav_base",
		"bON": true,
		"thread": {
			"FPS": 30
		},
		"/_StateControl": "state",
		"MavlinkStream": "mavAP_stream",
		"/MavlinkStream": "mavUDP_stream",
		"apType": 0,
		"ieSendHB": 1,
		"ieSendMsgInt": 1,
		"mavMsgInt": {
			"heartbeat": {
				"id": 0,
				"tInt": 1
			},
			"attitude": {
				"id": 30,
				"tInt": 0.05
			},
			"rcChannels": {
				"id": 65,
				"tInt": 1.0
			},
			"localPosition": {
				"id": 32,
				"tInt": 0.5
			},
			"globalPosition": {
				"id": 33,
				"tInt": 0.5
			},
			"homePosition": {
				"id": 242,
				"tInt": 10
			},
			"batteryStatus": {
				"id": 147,
				"tInt": 10
			},
			"missionCurrent": {
				"id": 42,
				"tInt": 1
			}
		}
	},
	"udp": {
		"BytePacketStreamIn": "udp_tx",
		"BytePacketStreamOut": "udp_rx",
		"class": "_UDP",
		"bON": false,
		"bLog": false,
		"thread": {
			"FPS": 30
		},
		"threadR": {
			"FPS": 30
		},
		"/addr": "127.0.0.1",
		"port": 14550
	},
	"mavUDP": {
		"class": "_Mavlink",
		"MavlinkStream": "mavUDP_stream",
		"bON": false,
		"bLog": false,
		"thread": {
			"FPS": 10
		},
		"BytePacketStreamIn": "udp_rx",
		"BytePacketStreamOut": "udp_tx",
		"/devSystemID": 1,
		"mySystemID": 200,
		"iMavComm": 0
	},
	"mavAP_stream": {
		"type": "dataObject",
		"class": "MavlinkStream",
		"nMsgQueue": 1024
	},
	"mavUDP_stream": {
		"type": "dataObject",
		"class": "MavlinkStream",
		"nMsgQueue": 1024
	},
	"serial_tx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 1024,
		"nPbuf": 512
	},
	"serial_rx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 1024,
		"nPbuf": 512
	},
	"udp_tx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	},
	"udp_rx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	}
}