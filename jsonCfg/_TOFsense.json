{
	"APP": {
		"class": "InstanceMgr",
		"appName": "OpenKAI",
		"bLog": false,
		"bStdErr": true
	},
	"console": {
		"class": "_Console",
		"bON": true,
		"thread": {
			"FPS": 30
		},
		"vBASE": [
			"serial",
			"TOFsense"
		]
	},
	"serial": {
		"BytePacketStreamOut": "serial_rx",
		"class": "_SerialPort",
		"bON": true,
		"thread": {
			"FPS": 100
		},
		"threadR": {
			"FPS": 100
		},
		"bLog": true,
		"port": "/dev/ttyAMA1",
		"baud": 921600,
		"/threadR": {
			"FPS": 30
		}
	},
	"TOFsense": {
		"class": "_TOFsense",
		"bON": true,
		"thread": {
			"FPS": 30
		},
		"bLog": true,
		"BytePacketStreamIn": "serial_rx"
	},
	"serial_rx": {
		"type": "dataObject",
		"class": "BytePacketStream",
		"nPacket": 256,
		"nPbuf": 2000
	}
}
