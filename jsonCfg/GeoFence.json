{
	"APP": {
		"class": "InstanceMgr",
		"appName": "OpenKAI",
		"bLog": true,
		"bStdErr": true
	},
	"console": {
		"class": "_Console",
		"bON": false,
		"thread": {
			"FPS": 10
		},
		"vBASE": [
			"/serialAP",
			"/mavAP",
			"apBase",
			"geoFence"
		]
	},

	"wsServer": {
		"BytePacketStreamIn": "wsServer_tx",
		"BytePacketStreamOut": "wsServer_rx",
		"class": "_WebSocketServer",
		"bON": true,
		"bLog": 0,
		"thread": {
			"FPS": 10
		},
		"threadR": {
			"FPS": 10
		},
		"wsMode": 2,
		"host": "0.0.0.0",
		"port": 7890,
		"tOutMs": 10000
	},
	"wsConsole": {
		"class": "_WSconsole",
		"bON": true,
		"thread": {
			"FPS": 1
		},
		"threadR": {
			"FPS": 1
		},
		"vBASE": [
			"geoFence"
		],
		"msgFinishSend": "",
		"msgFinishRecv": "EOJ",
		"BytePacketStreamIn": "wsServer_rx",
		"BytePacketStreamOut": "wsServer_tx"
	},


	"serialAP": {
		"BytePacketStreamIn": "serialAP_tx",
		"BytePacketStreamOut": "serialAP_rx",
		"class": "_SerialPort",
		"bON": false,
		"thread": {
			"FPS": 30
		},
		"threadR": {
			"FPS": 30
		},
		"port": "/dev/ttyACM0",
		"baud": 115200
	},
	"udpAP": {
		"BytePacketStreamIn": "udpAP_tx",
		"BytePacketStreamOut": "udpAP_rx",
		"class": "_UDP",
		"bON": true,
		"thread": {
			"FPS": 30
		},
		"threadR": {
			"FPS": 30
		},
