{
	"APP": {
		"class": "InstanceMgr",
		"appName": "OpenKAI",
		"bLog": false,
		"bStdErr": true
	},
	"console": {
		"class": "_Console",
		"bON": true,
		"thread": {
			"FPS": 30
		},
		"vBASE": [
			"modbus",
			"stepperX",
			"stepperY"
		]
	},
	"modbus": {
		"class": "_Modbus",
		"bON": true,
		"thread": {
			"FPS": 30
		},
		"bLog": false,
		"/type": "RTU",
