			"run": 7,
			"stop": 3,
			"resPos": 10
		},
		"pOrigin": 0.0,
		"pTarget": 5.0,
		"pErr": 0.01,
		"pRange": [
			0,
			15
		],
		"sTarget": 300.0,
		"sRange": [
			0,
			300
		],
		"aTarget": 100.0,
		"aRange": [
			1,
			300
		],
		"/bFeedback": 1
	},
